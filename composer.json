{
    "name": "alchemy/queue-bundle",
    "description": "Symfony bundle for alchemy/queue-component",
    "authors": [
        {
            "name": "Thibaud Fabre",
            "email": "thibaud@aztech.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Alchemy\\QueueBundle\\": "src/QueueBundle"
