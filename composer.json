        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "require": {
        "php": "^8.5",
        "alchemy/queue-component": "^6.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "suggest": {
        "symfony/config": "To use the Symfony bundle (^7.4)",
        "symfony/dependency-injection": "To use the Symfony bundle (^7.4)",
        "symfony/http-kernel": "To use the Symfony bundle (^7.4)"
    }
